# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =====================================================================
# Sam_Att V2 — Backend & Database Configuration (Phase 1+2 Hardening)
# =====================================================================

# Repository Mode: MOCK | TEST | REAL
# - MOCK: In-Memory Repository (for UI Prototype & local development)
# - TEST: Persistent File-Backed SQL / Test Repository (for Automated Integration Tests)
# - REAL: MySQL Connection Pool Repository (requires SAM_ATT_DB_* and SAM_ATT_JWT_SECRET; never falls back to Mock)
SAM_ATT_REPO_MODE="MOCK"

# Mandatory in REAL / Production mode (min 32 characters; no hardcoded fallback allowed in REAL mode)
SAM_ATT_JWT_SECRET=""

# Sam_Att Isolated MySQL Database (samchuk_attendance)
SAM_ATT_DB_HOST=""
SAM_ATT_DB_PORT="3306"
SAM_ATT_DB_NAME="samchuk_attendance"
SAM_ATT_DB_USER=""
SAM_ATT_DB_PASSWORD=""
SAM_ATT_DB_CONNECTION_LIMIT="10"

# HOSOffice Authoritative Read-Only Database (hosoffice)
HOSOFFICE_DB_HOST=""
HOSOFFICE_DB_PORT="3306"
HOSOFFICE_DB_NAME="hosoffice"
HOSOFFICE_DB_USER=""
HOSOFFICE_DB_PASSWORD=""
HOSOFFICE_HR_PERSON_TABLE="hr_person"
