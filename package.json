{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:frontend && npm run build:backend",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && npm run build:agent && tsx --test backend/__tests__/*.test.ts",
    "test:unit": "tsx --test backend/__tests__/attendanceEngine.unit.test.ts",
    "test:integration": "npm run build && tsx --test backend/__tests__/samAttPhase2.integration.test.ts backend/__tests__/deploymentHost.test.ts",
    "build:frontend": "vite build",
    "build:backend": "node scripts/build-backend.mjs",
    "test:security": "tsx --test backend/__tests__/deploymentSecurity.test.ts",
    "test:deployment": "tsx --test backend/__tests__/deploymentSecurity.test.ts",
    "build:agent": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native-agent.ps1",
    "test:native": "npm run build:backend && npm run build:agent && tsx --test backend/__tests__/deploymentNative.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
